# ---- LLM (optional — deterministic mode works with none of these) ----
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
HF_TOKEN=
OLLAMA_HOST=
LLM_MODEL=

# ---- Web research ----
# Provider precedence: TAVILY_API_KEY > BRAVE_API_KEY > DuckDuckGo (no key,
# HTML-scraping fallback, prone to being blocked). Every option except
# DuckDuckGo needs a one-time free API-key signup (a developer step, not an
# end-user login) — recommended, in order:
#   1. Tavily — https://app.tavily.com — free tier: 1,000 searches/month, no card.
#   2. Brave  — https://api-dashboard.search.brave.com — has a free tier too;
#      check their pricing page for current limits.
TAVILY_API_KEY=
BRAVE_API_KEY=
DISABLE_WEB_RESEARCH=false

# ---- RAG ----
RAG_BACKEND=auto   # auto | tfidf | faiss

# ---- Database ----
CONAI_DB_PATH=./data/conai.db

# ---- Email (optional — DRY RUN if unset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
